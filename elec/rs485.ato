/// Isolated RS-485 (Modbus) PHY + field connector.
.ELEC: @STD::Import {
    .project &= "electronics"
    .org     &= "atopile"
}

.TD301: @STD::Import {
    .org     &= "jlc"
    .project &= "C882123"
}

.TERM_AB: @STD::Import {
    .org     &= "jlc"
    .project &= "C9900018120"
}

/// 3.3 V isolated RS-485 half-duplex for Modbus RTU master.
.IsolatedRs485: @type {
    .power: ELEC::ElectricPower {
        .voltage &= 3.3V +/- 5%
    }

    .uart_tx: ELEC::ElectricLogic
    .uart_rx: ELEC::ElectricLogic
    .de:      ELEC::ElectricLogic
    .uart_tx.reference ~ .power
    .uart_rx.reference ~ .power
    .de.reference ~ .power

    .mod: TD301::VISOM_TD301D485H
    .mod.VCC ~ .power.hv
    .mod.GND ~ .power.lv
    .mod.TXD ~ .uart_tx.line
    .mod.RXD ~ .uart_rx.line
    .mod.COM ~ .de.line

    .c_vcc: ELEC::Capacitor {
        .capacitance &= 100nF +/- 10%
        .max_voltage >= 6.3V
        @trait(_): ELEC::PARTS::has_package_requirements { .size &= "0402" }
    }
    .power.hv ~> .c_vcc ~> .power.lv

    .r_term: ELEC::Resistor {
        .resistance &= 120ohm +/- 5%
        @trait(_): ELEC::PARTS::has_package_requirements { .size &= "0603" }
    }
    .mod.A ~> .r_term ~> .mod.B

    .connector: TERM_AB::JLCPCB_Assembly_RS485_3_5_2PEuropean_terminal
    .connector.'1' ~ .mod.A
    .connector.'2' ~ .mod.B

    /// Isolated bus reference exposed for shield / ISO-GND terminal if needed.
    .iso_gnd := .mod.RGND
}
