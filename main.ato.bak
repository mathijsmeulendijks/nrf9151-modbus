/// nRF9151 industrial node - mains, eFuse supercap hold-up, TI isolated RS-485/RS-232/CAN.
.ELEC: @STD::Import {
    .project &= "electronics"
    .org     &= "atopile"
}

# power
/// Mains AC-DC, TPS2595 eFuse supercap charge, 3.3 V rail, brownout.
.IRM10: @STD::Import {
    .org     &= "jlc"
    .project &= "C2857903"
}

.LDO33: @STD::Import {
    .org     &= "jlc"
    .project &= "C91728"
}

.SUPERCAP: @STD::Import {
    .org     &= "jlc"
    .project &= "C9900166265"
}

.SUPERVISOR: @STD::Import {
    .org     &= "jlc"
    .project &= "C2066862"
}

.EFUSE: @STD::Import {
    .org     &= "jlc"
    .project &= "C2155674"
}

/// Panel AC -> 5 V IRM -> eFuse-charged supercap OR -> 3.3 V LDO + UVLO.
.PowerTree: @type {
    .ac_l: ELEC::Electrical
    .ac_n: ELEC::Electrical

    .power_5v_raw: ELEC::ElectricPower {
        .voltage &= 5V +/- 5%
    }
    .power_vsys: ELEC::ElectricPower {
        .voltage &= 4.0V..5.25V
    }
    .power_3v3: ELEC::ElectricPower {
        .voltage &= 3.3V +/- 5%
    }

    .n_reset: ELEC::ElectricLogic
    .n_reset.reference ~ .power_3v3

    .vsys_sense: ELEC::ElectricLogic
    .vsys_sense.reference ~ .power_3v3

    .irm: IRM10::MW_IRM_10_5
    .irm.AC_L ~ .ac_l
    .irm.AC_N ~ .ac_n
    .irm.Vpos ~ .power_5v_raw.hv
    .irm.Vneg ~ .power_5v_raw.lv
    .power_5v_raw.lv ~ .power_vsys.lv
    .power_vsys.lv ~ .power_3v3.lv

    .c_bulk_5v: ELEC::Capacitor {
        .capacitance &= 100uF +/- 20%
        .max_voltage >= 10V
        @trait(_): ELEC::PARTS::has_package_requirements { .size &= "1206" }
    }
    .power_5v_raw.hv ~> .c_bulk_5v ~> .power_5v_raw.lv

    /// Smart supercap charge limiter: TI TPS259531 eFuse (~34 mOhm Rds(on)).
    /// ILIMIT ~ 0.5 A via RILM=4.42k (ILIM = 2000/RILM + 0.04). No series-R drop when charged.
    /// 5.7 V OVC protects the 5.5 V supercap. EN/UVLO tied high (always on when 5 V present).
    .charge_efuse: EFUSE::Texas_Instruments_TPS259531DSGR
    .charge_efuse.IN_3 ~ .power_5v_raw.hv
    .charge_efuse.IN_4 ~ .power_5v_raw.hv
    .charge_efuse.GND_8 ~ .power_5v_raw.lv
    .charge_efuse.GND_9 ~ .power_5v_raw.lv
    .charge_efuse.EN_UVLO ~ .power_5v_raw.hv

    .r_ilm: ELEC::Resistor {
        .resistance &= 4.42kohm +/- 1%
        @trait(_): ELEC::PARTS::has_package_requirements { .size &= "0402" }
    }
    .charge_efuse.ILM ~> .r_ilm ~> .power_5v_raw.lv

    .c_efuse_in: ELEC::Capacitor {
        .capacitance &= 100nF +/- 10%
        .max_voltage >= 10V
        @trait(_): ELEC::PARTS::has_package_requirements { .size &= "0402" }
    }
    .c_efuse_out: ELEC::Capacitor {
        .capacitance &= 1uF +/- 10%
        .max_voltage >= 10V
        @trait(_): ELEC::PARTS::has_package_requirements { .size &= "0603" }
    }
    .power_5v_raw.hv ~> .c_efuse_in ~> .power_5v_raw.lv
    .charge_efuse.OUT ~> .c_efuse_out ~> .power_5v_raw.lv

    .r_flt: ELEC::Resistor {
        .resistance &= 10kohm +/- 5%
        @trait(_): ELEC::PARTS::has_package_requirements { .size &= "0402" }
    }
    .power_5v_raw.hv ~> .r_flt ~> .charge_efuse.nFLT

    .supercap: SUPERCAP::JLCPCB_Assembly_0_47F5_5VDC
    .d_irm_or: ELEC::Diode {
        .forward_voltage &= 0.3V..0.6V
        .max_current >= 1A
        .reverse_working_voltage >= 40V
    }
    @trait(_, .d_irm_or): ELEC::PARTS::is_pickable_by_supplier_id {
        .supplier &= "LCSC"
        .supplier_part_id &= "C444721"
    }
    .d_scap_or: ELEC::Diode {
        .forward_voltage &= 0.3V..0.6V
        .max_current >= 1A
        .reverse_working_voltage >= 40V
    }
    @trait(_, .d_scap_or): ELEC::PARTS::is_pickable_by_supplier_id {
        .supplier &= "LCSC"
        .supplier_part_id &= "C444721"
    }

    .charge_efuse.OUT ~ .supercap.'1'
    .supercap.'2' ~ .power_5v_raw.lv

    .power_5v_raw.hv ~> .d_irm_or ~> .power_vsys.hv
    .supercap.'1' ~> .d_scap_or ~> .power_vsys.hv

    .c_vsys: ELEC::Capacitor {
        .capacitance &= 47uF +/- 20%
        .max_voltage >= 10V
        @trait(_): ELEC::PARTS::has_package_requirements { .size &= "1206" }
    }
    .power_vsys.hv ~> .c_vsys ~> .power_vsys.lv

    .ldo: LDO33::Texas_Instruments_TLV1117_33CDCYR
    .ldo.INPUT ~ .power_vsys.hv
    .ldo.OUTPUT_2 ~ .power_3v3.hv
    .ldo.OUTPUT_4 ~ .power_3v3.hv
    .ldo.ADJ_GND ~ .power_3v3.lv

    .c_ldo_in: ELEC::Capacitor {
        .capacitance &= 10uF +/- 20%
        .max_voltage >= 10V
        @trait(_): ELEC::PARTS::has_package_requirements { .size &= "0805" }
    }
    .c_ldo_out: ELEC::Capacitor {
        .capacitance &= 22uF +/- 20%
        .max_voltage >= 6.3V
        @trait(_): ELEC::PARTS::has_package_requirements { .size &= "0805" }
    }
    .power_vsys.hv ~> .c_ldo_in ~> .power_vsys.lv
    .power_3v3.hv ~> .c_ldo_out ~> .power_3v3.lv

    .uvlo: SUPERVISOR::Diodes_Incorporated_APX803L_29SA_7
    .uvlo.VCC ~ .power_3v3.hv
    .uvlo.GND ~ .power_3v3.lv
    .uvlo.nRESET ~ .n_reset.line

    .n_reset_pullup: ELEC::Resistor {
        .resistance &= 10kohm +/- 5%
        @trait(_): ELEC::PARTS::has_package_requirements { .size &= "0402" }
    }
    .power_3v3.hv ~> .n_reset_pullup ~> .n_reset.line

    .r_sense_hi: ELEC::Resistor {
        .resistance &= 100kohm +/- 1%
        @trait(_): ELEC::PARTS::has_package_requirements { .size &= "0402" }
    }
    .r_sense_lo: ELEC::Resistor {
        .resistance &= 100kohm +/- 1%
        @trait(_): ELEC::PARTS::has_package_requirements { .size &= "0402" }
    }
    .c_sense: ELEC::Capacitor {
        .capacitance &= 100nF +/- 10%
        .max_voltage >= 6.3V
        @trait(_): ELEC::PARTS::has_package_requirements { .size &= "0402" }
    }
    .power_vsys.hv ~> .r_sense_hi ~> .vsys_sense.line
    .vsys_sense.line ~> .r_sense_lo ~> .power_vsys.lv
    .vsys_sense.line ~> .c_sense ~> .power_vsys.lv

    @trait(_, .power_5v_raw.hv): ELEC::has_net_name_suggestion { .name &= "V5V_RAW"; .level &= "SUGGESTED" }
    @trait(_, .power_vsys.hv): ELEC::has_net_name_suggestion { .name &= "VSYS"; .level &= "SUGGESTED" }
    @trait(_, .power_3v3.hv): ELEC::has_net_name_suggestion { .name &= "VDD_3V3"; .level &= "SUGGESTED" }
}

# nrf core
/// nRF9151 SiP core: power, debug, reset, RF, SIM, application I/O.
.NRF: @STD::Import {
    .org     &= "jlc"
    .project &= "C42236596"
}

.FERRITE_VDD: @STD::Import {
    .org     &= "jlc"
    .project &= "C88982"
}

.IPEX: @STD::Import {
    .org     &= "jlc"
    .project &= "C437254"
}

.SIM_H: @STD::Import {
    .org     &= "jlc"
    .project &= "C381069"
}

.SWD_HDR: @STD::Import {
    .org     &= "jlc"
    .project &= "C9900011230"
}

.BTN: @STD::Import {
    .org     &= "jlc"
    .project &= "C223763"
}

.Nrf9151Core: @type {
    .power: ELEC::ElectricPower {
        .voltage &= 3.3V +/- 5%
    }

    /// Shared reset (UVLO + button + SWD + external).
    .n_reset: ELEC::ElectricLogic
    .n_reset.reference ~ .power

    .uart_tx: ELEC::ElectricLogic
    .uart_rx: ELEC::ElectricLogic
    .de:      ELEC::ElectricLogic
    .uart_tx.reference ~ .power
    .uart_rx.reference ~ .power
    .de.reference ~ .power

    .i2c: ELEC::I2C
    .i2c.frequency &= 400kHz

    .vsys_sense: ELEC::ElectricLogic
    .vsys_sense.reference ~ .power

    .sip: NRF::Nordic_Semicon_NRF9151_LACA_R

    # Filtered modem supply (Nordic nRF9151 HDG / PS ref: FB + bulk on VDD)
    .power_vdd: ELEC::ElectricPower {
        .voltage &= 3.3V +/- 5%
    }
    .power_vdd.lv ~ .power.lv

    # Power
    .sip.VDD ~ .power_vdd.hv
    .sip.VDD_GPIO ~ .power.hv
    .sip.nRESET ~ .n_reset.line

    # Grounds (all GND pads + thermal shield pads)
    @for([
        .sip.GND_1, .sip.GND_7, .sip.GND_13, .sip.GND_15, .sip.GND_20,
        .sip.GND_25, .sip.GND_30, .sip.GND_34, .sip.GND_36, .sip.GND_38,
        .sip.GND_39, .sip.GND_40, .sip.GND_41, .sip.GND_43, .sip.GND_46,
        .sip.GND_51, .sip.GND_55, .sip.GND_60, .sip.GND_66, .sip.GND_71,
        .sip.GND_76, .sip.GND_105, .sip.GND_106, .sip.GND_107, .sip.GND_108,
        .sip.GND_109, .sip.GND_110, .sip.GND_111, .sip.GND_112, .sip.GND_113
    ], {
        .obj ~ power.lv
    })

    # --- Nordic VDD filter (PS Fig.125 / HDG): source caps -> FB -> SiP bulk ---
    # Source side of FB (board 3V3): 1 uF + 1 uF
    .c_vdd_src_a: ELEC::Capacitor {
        .capacitance &= 1uF +/- 10%
        .max_voltage >= 6.3V
        @trait(_): ELEC::PARTS::has_package_requirements { .size &= "0603" }
    }
    .c_vdd_src_b: ELEC::Capacitor {
        .capacitance &= 1uF +/- 10%
        .max_voltage >= 6.3V
        @trait(_): ELEC::PARTS::has_package_requirements { .size &= "0603" }
    }
    .power.hv ~> .c_vdd_src_a ~> .power.lv
    .power.hv ~> .c_vdd_src_b ~> .power.lv

    # Low-DCR ferrite (Murata BLM18KG300TN1D: 30 ohm @ 100 MHz, 5 A, ~10 mOhm DCR)
    .fb_vdd: FERRITE_VDD::Murata_Electronics_BLM18KG300TN1D
    .power.hv ~ .fb_vdd.'1'
    .fb_vdd.'2' ~ .power_vdd.hv

    # SiP side of FB: 47 uF + 10 uF (Nordic official; 10 uF alone is OK but 47 preferred)
    .c_vdd_bulk: ELEC::Capacitor {
        .capacitance &= 47uF +/- 20%
        .max_voltage >= 6.3V
        @trait(_): ELEC::PARTS::has_package_requirements { .size &= "1206" }
    }
    .c_vdd_mid: ELEC::Capacitor {
        .capacitance &= 10uF +/- 20%
        .max_voltage >= 6.3V
        @trait(_): ELEC::PARTS::has_package_requirements { .size &= "0805" }
    }
    .c_vdd_hf: ELEC::Capacitor {
        .capacitance &= 100nF +/- 10%
        .max_voltage >= 6.3V
        @trait(_): ELEC::PARTS::has_package_requirements { .size &= "0402" }
    }
    .c_vdd_rf: ELEC::Capacitor {
        .capacitance &= 10nF +/- 10%
        .max_voltage >= 6.3V
        @trait(_): ELEC::PARTS::has_package_requirements { .size &= "0402" }
    }
    .power_vdd.hv ~> .c_vdd_bulk ~> .power_vdd.lv
    .power_vdd.hv ~> .c_vdd_mid ~> .power_vdd.lv
    .power_vdd.hv ~> .c_vdd_hf ~> .power_vdd.lv
    .power_vdd.hv ~> .c_vdd_rf ~> .power_vdd.lv

    # VDD_GPIO local decoupling (same 3V3 domain as GPIOs / SWD)
    .c_vdd_gpio_bulk: ELEC::Capacitor {
        .capacitance &= 10uF +/- 20%
        .max_voltage >= 6.3V
        @trait(_): ELEC::PARTS::has_package_requirements { .size &= "0805" }
    }
    .c_vdd_gpio_hf: ELEC::Capacitor {
        .capacitance &= 100nF +/- 10%
        .max_voltage >= 6.3V
        @trait(_): ELEC::PARTS::has_package_requirements { .size &= "0402" }
    }
    .power.hv ~> .c_vdd_gpio_bulk ~> .power.lv
    .power.hv ~> .c_vdd_gpio_hf ~> .power.lv

    # DEC0 - internal core rail decoupling (~2.2 V); 4.7 uF per Nordic DK/HDG
    .c_dec0: ELEC::Capacitor {
        .capacitance &= 4.7uF +/- 20%
        .max_voltage >= 6.3V
        @trait(_): ELEC::PARTS::has_package_requirements { .size &= "0603" }
    }
    .sip.DEC0 ~> .c_dec0 ~> .power.lv

    # ENABLE pull-up (ref R1); already tied high, keep explicit resistor for noise immunity
    .r_enable: ELEC::Resistor {
        .resistance &= 10kohm +/- 5%
        @trait(_): ELEC::PARTS::has_package_requirements { .size &= "0402" }
    }
    .power.hv ~> .r_enable ~> .sip.ENABLE

    @trait(_, .power_vdd.hv): ELEC::has_net_name_suggestion { .name &= "VDD_nRF"; .level &= "SUGGESTED" }

    # Application UART / RS-485 direction (P0.10 TX, P0.11 RX, P0.12 DE)
    .sip.P0_10 ~ .uart_tx.line
    .sip.P0_11 ~ .uart_rx.line
    .sip.P0_12 ~ .de.line

    # I2C (P0.02 SDA, P0.03 SCL)
    .sip.P0_02 ~ .i2c.sda.line
    .sip.P0_03 ~ .i2c.scl.line
    .i2c.sda.reference ~ .power
    .i2c.scl.reference ~ .power

    .i2c_pullup_sda: ELEC::Resistor {
        .resistance &= 4.7kohm +/- 5%
        @trait(_): ELEC::PARTS::has_package_requirements { .size &= "0402" }
    }
    .i2c_pullup_scl: ELEC::Resistor {
        .resistance &= 4.7kohm +/- 5%
        @trait(_): ELEC::PARTS::has_package_requirements { .size &= "0402" }
    }
    .power.hv ~> .i2c_pullup_sda ~> .i2c.sda.line
    .power.hv ~> .i2c_pullup_scl ~> .i2c.scl.line

    # VSYS ADC sense (P0.04)
    .sip.P0_04 ~ .vsys_sense.line

    # SPI for MCP2515 CAN controller (P0.15 SCK, P0.16 MOSI, P0.17 MISO, P0.18 CS)
    .spi: ELEC::SPI
    .spi.sclk.reference ~ .power
    .spi.mosi.reference ~ .power
    .spi.miso.reference ~ .power
    .spi_cs: ELEC::ElectricLogic
    .spi_cs.reference ~ .power
    .can_int: ELEC::ElectricLogic
    .can_int.reference ~ .power

    .sip.P0_15 ~ .spi.sclk.line
    .sip.P0_16 ~ .spi.mosi.line
    .sip.P0_17 ~ .spi.miso.line
    .sip.P0_18 ~ .spi_cs.line
    .sip.P0_19 ~ .can_int.line

    # Second UART for RS-232 (P0.13 TX, P0.14 RX)
    .uart2_tx: ELEC::ElectricLogic
    .uart2_rx: ELEC::ElectricLogic
    .uart2_tx.reference ~ .power
    .uart2_rx.reference ~ .power
    .sip.P0_13 ~ .uart2_tx.line
    .sip.P0_14 ~ .uart2_rx.line

    # --- LTE external antenna (IPEX) ---
    .lte_ant: IPEX::ECT_ECT818000500
    .sip.ANT ~ .lte_ant.CONT
    .lte_ant.GND_1 ~ .power.lv
    .lte_ant.GND_3 ~ .power.lv
    .lte_ant.GND_4 ~ .power.lv

    # --- GNSS external antenna (IPEX) - passive ---
    .gnss_ant: IPEX::ECT_ECT818000500
    .sip.GPS ~ .gnss_ant.CONT
    .gnss_ant.GND_1 ~ .power.lv
    .gnss_ant.GND_3 ~ .power.lv
    .gnss_ant.GND_4 ~ .power.lv

    # AUX unused (no RF switch): terminate 50 ohm to GND so LTE/GNSS
    # coexistence can dump ANT load via AUX when firmware enables it
    .r_aux_term: ELEC::Resistor {
        .resistance &= 49.9ohm +/- 1%
        @trait(_): ELEC::PARTS::has_package_requirements { .size &= "0402" }
    }
    .sip.AUX ~> .r_aux_term ~> .power.lv

    # nRESET RC: external 10 k pull-up is on PowerTree; add local noise cap.
    # SiP has internal ~13 k to ~2.2 V; hold low >= 5 us for pin reset.
    .c_nreset: ELEC::Capacitor {
        .capacitance &= 100nF +/- 10%
        .max_voltage >= 6.3V
        @trait(_): ELEC::PARTS::has_package_requirements { .size &= "0402" }
    }
    .n_reset.line ~> .c_nreset ~> .power.lv

    # --- Nano-SIM ---
    .sim: SIM_H::XKB_Connection_XKSIM_008
    .sim.VCC ~ .sip.SIM_1V8
    .sim.RST ~ .sip.SIM_RST
    .sim.CLK ~ .sip.SIM_CLK
    .sim.I_O ~ .sip.SIM_IO
    .sim.GND ~ .power.lv
    .sim.VPP ~ .sip.SIM_1V8
    .sip.SIM_DET ~ .power.lv

    # UICC supply decoupling at SiP + holder (Nordic SIMIF is internal 1.8 V LDO)
    .c_sim_hf: ELEC::Capacitor {
        .capacitance &= 100nF +/- 10%
        .max_voltage >= 6.3V
        @trait(_): ELEC::PARTS::has_package_requirements { .size &= "0402" }
    }
    .c_sim_bulk: ELEC::Capacitor {
        .capacitance &= 1uF +/- 10%
        .max_voltage >= 6.3V
        @trait(_): ELEC::PARTS::has_package_requirements { .size &= "0603" }
    }
    .sip.SIM_1V8 ~> .c_sim_hf ~> .power.lv
    .sip.SIM_1V8 ~> .c_sim_bulk ~> .power.lv

    # --- SWD / J-Link 1.27 mm 10-pin (Cortex debug) ---
    .swd: SWD_HDR::JLCPCB_Assembly_FTSH_105_01_F_D_K
    .swd.'1' ~ .power.hv
    .swd.'2' ~ .sip.SWDIO
    .swd.'3' ~ .power.lv
    .swd.'4' ~ .sip.SWDCLK
    .swd.'5' ~ .power.lv
    .swd.'9' ~ .power.lv
    .swd.'10' ~ .n_reset.line

    .swdio_pullup: ELEC::Resistor {
        .resistance &= 10kohm +/- 5%
        @trait(_): ELEC::PARTS::has_package_requirements { .size &= "0402" }
    }
    .power.hv ~> .swdio_pullup ~> .sip.SWDIO

    # --- Reset: on-board tactile + external pads ---
    .reset_btn: BTN::Korean_Hroparts_Elec_K2_1102SP_D4SC_04
    .reset_btn.'1' ~ .n_reset.line
    .reset_btn.'2' ~ .n_reset.line
    .reset_btn.'3' ~ .power.lv
    .reset_btn.'4' ~ .power.lv

    .ext_reset_a: ELEC::TestPoint
    .ext_reset_b: ELEC::TestPoint
    .ext_reset_a.contact ~ .n_reset.line
    .ext_reset_b.contact ~ .power.lv

    .ac_l_tp: ELEC::TestPoint
    .ac_n_tp: ELEC::TestPoint
}

# rs485
/// Isolated RS-485 (Modbus) PHY + field connector.
.ISOW1412: @STD::Import {
    .org     &= "jlc"
    .project &= "C5216548"
}

/// TI ISOW1412: reinforced isolated RS-485 + integrated isolated DC-DC (half-duplex).
.IsolatedRs485: @type {
    .power: ELEC::ElectricPower {
        .voltage &= 3.3V +/- 5%
    }

    .uart_tx: ELEC::ElectricLogic
    .uart_rx: ELEC::ElectricLogic
    .de:      ELEC::ElectricLogic
    .uart_tx.reference ~ .power
    .uart_rx.reference ~ .power
    .de.reference ~ .power

    .ic: ISOW1412::Texas_Instruments_ISOW1412DFMR

    # Logic / primary side (3.3 V)
    .ic.VIO ~ .power.hv
    .ic.VDD ~ .power.hv
    .ic.GND1 ~ .power.lv
    .ic.GNDIO ~ .power.lv
    .ic.D ~ .uart_tx.line
    .ic.R ~ .uart_rx.line
    # Single DE: DE active-high, RE active-low — tie together for half-duplex direction
    .ic.DE ~ .de.line
    .ic.nRE ~ .de.line

    # EN/FLT as enable: pull high so isolated DC-DC stays on
    .r_en: ELEC::Resistor {
        .resistance &= 10kohm +/- 5%
        @trait(_): ELEC::PARTS::has_package_requirements { .size &= "0402" }
    }
    .power.hv ~> .r_en ~> .ic.EN_FLT

    # Isolated side power: VISOOUT -> VISOIN, MODE=GND2 for 3.3 V bus
    .ic.VISOOUT ~ .ic.VISOIN
    .ic.GND2 ~ .ic.GISOIN
    .ic.MODE ~ .ic.GND2
    # General-purpose isolated IN unused -> GND2
    .ic.IN ~ .ic.GND2
    # OUT unused — leave open (no connect)

    # Half-duplex: short Y-A, Z-B
    .ic.Y ~ .ic.A
    .ic.Z ~ .ic.B

    .c_vio: ELEC::Capacitor {
        .capacitance &= 100nF +/- 10%
        .max_voltage >= 6.3V
        @trait(_): ELEC::PARTS::has_package_requirements { .size &= "0402" }
    }
    .c_vdd_hf: ELEC::Capacitor {
        .capacitance &= 10nF +/- 10%
        .max_voltage >= 6.3V
        @trait(_): ELEC::PARTS::has_package_requirements { .size &= "0402" }
    }
    .c_vdd_bulk: ELEC::Capacitor {
        .capacitance &= 10uF +/- 20%
        .max_voltage >= 6.3V
        @trait(_): ELEC::PARTS::has_package_requirements { .size &= "0805" }
    }
    .c_vdd_mf: ELEC::Capacitor {
        .capacitance &= 1uF +/- 10%
        .max_voltage >= 6.3V
        @trait(_): ELEC::PARTS::has_package_requirements { .size &= "0603" }
    }
    .power.hv ~> .c_vio ~> .power.lv
    .power.hv ~> .c_vdd_hf ~> .power.lv
    .power.hv ~> .c_vdd_bulk ~> .power.lv
    .power.hv ~> .c_vdd_mf ~> .power.lv

    .c_viso_hf: ELEC::Capacitor {
        .capacitance &= 10nF +/- 10%
        .max_voltage >= 6.3V
        @trait(_): ELEC::PARTS::has_package_requirements { .size &= "0402" }
    }
    .c_viso_mf: ELEC::Capacitor {
        .capacitance &= 1uF +/- 10%
        .max_voltage >= 6.3V
        @trait(_): ELEC::PARTS::has_package_requirements { .size &= "0603" }
    }
    .c_viso_bulk: ELEC::Capacitor {
        .capacitance &= 10uF +/- 20%
        .max_voltage >= 6.3V
        @trait(_): ELEC::PARTS::has_package_requirements { .size &= "0805" }
    }
    .ic.VISOOUT ~> .c_viso_hf ~> .ic.GND2
    .ic.VISOOUT ~> .c_viso_mf ~> .ic.GND2
    .ic.VISOOUT ~> .c_viso_bulk ~> .ic.GND2

    .r_term: ELEC::Resistor {
        .resistance &= 120ohm +/- 5%
        @trait(_): ELEC::PARTS::has_package_requirements { .size &= "0603" }
    }
    .ic.A ~> .r_term ~> .ic.B

    # Bus side for RJ45 (A/B stay galvanically isolated from board GND)
    .a := .ic.A
    .b := .ic.B
    .iso_gnd := .ic.GND2
}


# temp
/// Board ambient I2C temperature (TMP117).
.TMP117: @STD::Import {
    .org     &= "jlc"
    .project &= "C699536"
}

.BoardTemp: @type {
    .power: ELEC::ElectricPower {
        .voltage &= 3.3V +/- 5%
    }
    .i2c: ELEC::I2C
    .i2c.frequency &= 400kHz

    .sensor: TMP117::Texas_Instruments_TMP117AIDRVR
    .sensor.Vpos ~ .power.hv
    .sensor.GND ~ .power.lv
    .sensor.EP ~ .power.lv
    .sensor.SCL ~ .i2c.scl.line
    .sensor.SDA ~ .i2c.sda.line
    /// Address 0x48 with ADD0 = GND.
    .sensor.ADD0 ~ .power.lv

    .c_decouple: ELEC::Capacitor {
        .capacitance &= 100nF +/- 10%
        .max_voltage >= 6.3V
        @trait(_): ELEC::PARTS::has_package_requirements { .size &= "0402" }
    }
    .power.hv ~> .c_decouple ~> .power.lv

    .alert_pullup: ELEC::Resistor {
        .resistance &= 10kohm +/- 5%
        @trait(_): ELEC::PARTS::has_package_requirements { .size &= "0402" }
    }
    .power.hv ~> .alert_pullup ~> .sensor.ALERT
}


.MAX3232: @STD::Import {
    .org     &= "jlc"
    .project &= "C113205"
}

.HVD230: @STD::Import {
    .org     &= "jlc"
    .project &= "C12084"
}

.MCP2515: @STD::Import {
    .org     &= "jlc"
    .project &= "C153782"
}

.RJ45: @STD::Import {
    .org     &= "jlc"
    .project &= "C2683359"
}

/// 3.3 V RS-232 transceiver (MAX3232), TX/RX only.
.Rs232Port: @type {
    .power: ELEC::ElectricPower {
        .voltage &= 3.3V +/- 5%
    }
    .uart_tx: ELEC::ElectricLogic
    .uart_rx: ELEC::ElectricLogic
    .uart_tx.reference ~ .power
    .uart_rx.reference ~ .power

    .ic: MAX3232::Texas_Instruments_MAX3232IPWR
    .ic.VCC ~ .power.hv
    .ic.GND ~ .power.lv
    .ic.DIN1 ~ .uart_tx.line
    .ic.ROUT1 ~ .uart_rx.line

    # Charge-pump caps (0.1 uF typical)
    .c1: ELEC::Capacitor {
        .capacitance &= 100nF +/- 10%
        .max_voltage >= 16V
        @trait(_): ELEC::PARTS::has_package_requirements { .size &= "0603" }
    }
    .c2: ELEC::Capacitor {
        .capacitance &= 100nF +/- 10%
        .max_voltage >= 16V
        @trait(_): ELEC::PARTS::has_package_requirements { .size &= "0603" }
    }
    .c_vplus: ELEC::Capacitor {
        .capacitance &= 100nF +/- 10%
        .max_voltage >= 16V
        @trait(_): ELEC::PARTS::has_package_requirements { .size &= "0603" }
    }
    .c_vminus: ELEC::Capacitor {
        .capacitance &= 100nF +/- 10%
        .max_voltage >= 16V
        @trait(_): ELEC::PARTS::has_package_requirements { .size &= "0603" }
    }
    .c_vcc: ELEC::Capacitor {
        .capacitance &= 100nF +/- 10%
        .max_voltage >= 6.3V
        @trait(_): ELEC::PARTS::has_package_requirements { .size &= "0402" }
    }
    .ic.C1pos ~> .c1 ~> .ic.C1neg
    .ic.C2pos ~> .c2 ~> .ic.C2neg
    .ic.Vpos ~> .c_vplus ~> .power.lv
    .ic.Vneg ~> .c_vminus ~> .power.lv
    .power.hv ~> .c_vcc ~> .power.lv

    # Unused channel 2 inputs tied safely
    .ic.DIN2 ~ .power.hv
    .ic.RIN2 ~ .power.lv

    .tx_line := .ic.DOUT1
    .rx_line := .ic.RIN1
}

/// SPI CAN controller + 3.3 V transceiver.
.CanPort: @type {
    .power: ELEC::ElectricPower {
        .voltage &= 3.3V +/- 5%
    }
    .spi: ELEC::SPI
    .spi_cs: ELEC::ElectricLogic
    .n_int: ELEC::ElectricLogic
    .spi_cs.reference ~ .power
    .n_int.reference ~ .power

    .ctrl: MCP2515::Microchip_Tech_MCP2515T_I_SO
    .ctrl.VDD ~ .power.hv
    .ctrl.VSS ~ .power.lv
    .ctrl.SCK ~ .spi.sclk.line
    .ctrl.SI ~ .spi.mosi.line
    .ctrl.SO ~ .spi.miso.line
    .ctrl.nCS ~ .spi_cs.line
    .ctrl.nINT ~ .n_int.line
    .ctrl.nRESET ~ .power.hv

    .int_pullup: ELEC::Resistor {
        .resistance &= 10kohm +/- 5%
        @trait(_): ELEC::PARTS::has_package_requirements { .size &= "0402" }
    }
    .power.hv ~> .int_pullup ~> .ctrl.nINT

    # Tie unused RTS/BF high
    .ctrl.nTX0RTS ~ .power.hv
    .ctrl.nTX1RTS ~ .power.hv
    .ctrl.nTX2RTS ~ .power.hv
    .ctrl.nRX0BF ~ .power.hv
    .ctrl.nRX1BF ~ .power.hv

    .c_vdd: ELEC::Capacitor {
        .capacitance &= 100nF +/- 10%
        .max_voltage >= 6.3V
        @trait(_): ELEC::PARTS::has_package_requirements { .size &= "0402" }
    }
    .power.hv ~> .c_vdd ~> .power.lv

    .xtal: ELEC::Crystal {
        .frequency &= 8MHz +/- 0.005%
    }
    .ctrl.OSC1 ~ .xtal.unnamed[0]
    .ctrl.OSC2 ~ .xtal.unnamed[1]
    .c_xtal_a: ELEC::Capacitor {
        .capacitance &= 22pF +/- 10%
        .max_voltage >= 6.3V
        @trait(_): ELEC::PARTS::has_package_requirements { .size &= "0402" }
    }
    .c_xtal_b: ELEC::Capacitor {
        .capacitance &= 22pF +/- 10%
        .max_voltage >= 6.3V
        @trait(_): ELEC::PARTS::has_package_requirements { .size &= "0402" }
    }
    .ctrl.OSC1 ~> .c_xtal_a ~> .power.lv
    .ctrl.OSC2 ~> .c_xtal_b ~> .power.lv

    .phy: HVD230::Texas_Instruments_SN65HVD230DR
    .phy.VCC ~ .power.hv
    .phy.GND ~ .power.lv
    .phy.D ~ .ctrl.TXCAN
    .phy.R ~ .ctrl.RXCAN
    # RS = 0 for high speed
    .phy.RS ~ .power.lv
    .phy.VREF ~ .power.lv

    .c_phy: ELEC::Capacitor {
        .capacitance &= 100nF +/- 10%
        .max_voltage >= 6.3V
        @trait(_): ELEC::PARTS::has_package_requirements { .size &= "0402" }
    }
    .power.hv ~> .c_phy ~> .power.lv

    .r_term: ELEC::Resistor {
        .resistance &= 120ohm +/- 5%
        @trait(_): ELEC::PARTS::has_package_requirements { .size &= "0603" }
    }
    .phy.CANH ~> .r_term ~> .phy.CANL

    .can_h := .phy.CANH
    .can_l := .phy.CANL
}

/// Single RJ45 carrying RS-485 + RS-232 + CAN (custom pinout).
/// Pin map (RJ45 1..8):
///  1 RS485_A | 2 RS485_B | 3 RS232_TX | 4 CAN_H
///  5 CAN_L   | 6 RS232_RX | 7 GND     | 8 GND
/// Pads 9-10: shield to chassis/GND.
.FieldBusRj45: @type {
    .gnd: ELEC::Electrical
    .rs485_a: ELEC::Electrical
    .rs485_b: ELEC::Electrical
    .rs232_tx: ELEC::Electrical
    .rs232_rx: ELEC::Electrical
    .can_h: ELEC::Electrical
    .can_l: ELEC::Electrical

    .jack: RJ45::Shenzhen_Kinghelm_Elec_KH_RJ45_56_8P8C
    .jack.'1' ~ .rs485_a
    .jack.'2' ~ .rs485_b
    .jack.'3' ~ .rs232_tx
    .jack.'4' ~ .can_h
    .jack.'5' ~ .can_l
    .jack.'6' ~ .rs232_rx
    .jack.'7' ~ .gnd
    .jack.'8' ~ .gnd
    .jack.'9' ~ .gnd
    .jack.'10' ~ .gnd
}


.App: @type {
    .jlc_stackup: ELEC::JLCPCB::JLC041612_3313
    @trait(_):    ELEC::PCB::is_pcb

    .power: PowerTree

    .ac_l_tp: ELEC::TestPoint
    .ac_n_tp: ELEC::TestPoint
    .ac_l_tp.contact ~ .power.ac_l
    .ac_n_tp.contact ~ .power.ac_n

    .modem: Nrf9151Core
    .modem.power ~ .power.power_3v3
    .modem.n_reset ~ .power.n_reset
    .modem.vsys_sense ~ .power.vsys_sense

    .rs485: IsolatedRs485
    .rs485.power ~ .power.power_3v3
    .rs485.uart_tx ~ .modem.uart_tx
    .rs485.uart_rx ~ .modem.uart_rx
    .rs485.de ~ .modem.de

    .rs232: Rs232Port
    .rs232.power ~ .power.power_3v3
    .rs232.uart_tx ~ .modem.uart2_tx
    .rs232.uart_rx ~ .modem.uart2_rx

    .can: CanPort
    .can.power ~ .power.power_3v3
    .can.spi ~ .modem.spi
    .can.spi_cs ~ .modem.spi_cs
    .can.n_int ~ .modem.can_int

    .field: FieldBusRj45
    .field.gnd ~ .power.power_3v3.lv
    .field.rs485_a ~ .rs485.a
    .field.rs485_b ~ .rs485.b
    .field.rs232_tx ~ .rs232.tx_line
    .field.rs232_rx ~ .rs232.rx_line
    .field.can_h ~ .can.can_h
    .field.can_l ~ .can.can_l

    .temp: BoardTemp
    .temp.power ~ .power.power_3v3
    .temp.i2c ~ .modem.i2c
}
